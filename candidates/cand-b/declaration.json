    "requires_power_to_hold": false,
    "mechanism_kind": "geometric_interlock",
    "mechanism": "Spring-preloaded hooks seat in a groove on the plug neck. The hook shoulder is perpendicular to the pull direction, so tension is carried by the interlock and holds with no power.",
    "component_ids": [
      "latch-mech",
      "shell-a",
      "shell-b"
    ],
    "release": {
      "bounded_independent_release": true,
      "means": "Powering the SMA wire through the MOSFET pulls the hooks radially out of the groove against the spring. Release stroke is limited by the hook ring stop, and the unit releases without help from its neighbour."
    }
  },
  "alignment": [
    {
      "kind": "geometric_guide",
      "description": "Conical funnel in the socket mouth, taper on the plug tip, and two flats on the plug keying roll to 0 or 180 degrees.",
      "justification": "The approach push of the moving unit presses the plug taper on the funnel wall. The wall reaction has a component that centres the plug, and the flats allow only two roll angles. No magnet is used. Capture window not yet measured (Q36).",
      "component_ids": [
        "shell-a",
        "shell-b",
        "pogo-block"
      ]
    }
  ],
