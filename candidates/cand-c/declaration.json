  "retention": {
    "requires_power_to_hold": false,
    "mechanism_kind": "spring_preload",
    "mechanism": "Two spring-preloaded jaws in the tail socket close behind the 6 mm ball once it passes the throat and hold it with no power. The ball remains free to swivel against jaw friction, so shape is not locked.",
    "component_ids": [
      "tail-socket-cartridge",
      "head-ball-stud"
    ],
    "release": {
      "bounded_independent_release": true,
      "means": "The head unit retracts its ram with the head servo, pulling the ball out against the jaw spring force (bounded by the spring). A unit cannot release its own tail socket; a separate pull beyond the detent also separates the pair."
    }
  },
  "alignment": [
    {
      "kind": "geometric_guide",
      "description": "Conical funnel in the tail socket guides the ball onto the socket axis.",
      "justification": "The funnel walls act on the ball through contact while the units close by rolling; no magnetic force is assumed. Funnel half angle and depth are undefined.",
      "component_ids": [
        "tail-socket-cartridge"
      ]
    }
  ],
  "limitations": [
    "Component boxes of the two shell halves are schema placeholders: the shell lies outside the cavity by definition.",
    "Several masses and sizes are design allowances (chassis frame, cartridges, pole hardware, driver thickness) with estimate basis.",
    "Servo stall current and MCU current are not taken from the cited pages.",
    "Servo-to-ram linkage, jaw geometry, funnel angle, bearings and ring gear are undesigned.",
    "A sphere rests on one point; the gate-1 static-support test needs three table-contact points and is expected to fail.",
    "Ram stroke of 9 mm is not produced by a declared mechanism."
  ]
